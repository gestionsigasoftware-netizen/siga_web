VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Opcional: activa el envio de errores a Sentry (ver docs/fixes/monitoreo-errores-frontend-2026-09-11.md).
# Si se deja vacio, Sentry simplemente no se inicializa -- el resto del monitoreo sigue funcionando.
VITE_SENTRY_DSN=
# Opcional: mosaico oscuro real (estilo dark-v11) para el mapa "premium"
# de Impacto Misionero (ver docs/fixes/mapa-mapbox-dark-2026-09-23.md).
# Token PUBLICO de Mapbox (cuenta gratuita, capa gratis hasta 50,000
# cargas de mapa/mes) -- si se deja vacio, el mapa premium usa
# OpenStreetMap estandar en vez de fallar.
VITE_MAPBOX_TOKEN=
